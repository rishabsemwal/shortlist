# Firebase Client SDK — safe to expose to the browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK — SERVER ONLY. Never use NEXT_PUBLIC_ prefix here.
# Paste the ENTIRE contents of the downloaded JSON key as a single-line string.
# Tip: cat serviceAccount.json | jq -c . | pbcopy (macOS)
#      Get-Content serviceAccount.json | ConvertTo-Json -Compress (Windows PowerShell)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}
